# ============================================
# Infisical - Variáveis de Ambiente Obrigatórias
# ============================================
# Copie este arquivo para .env e preencha os valores:
#   cp .env.example .env
#
# Gere chaves seguras com:
#   openssl rand -base64 32  # para AUTH_SECRET
#   openssl rand -base64 32  # para ENCRYPTION_KEY (deve ter 32 chars)

# --- Obrigatórias ---
AUTH_SECRET=gere-uma-chave-com-openssl-rand-base64-32
ENCRYPTION_KEY=gere-outra-chave-de-32-chars-exatos
POSTGRES_PASSWORD=senha-forte-para-o-banco

# --- Opcionais: Email (SMTP) ---
# Configure para convites de usuários, reset de senha, etc.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=seu-email@gmail.com
SMTP_PASSWORD=sua-senha-de-app
SMTP_FROM_EMAIL=Infisical <noreply@seudominio.com>
SMTP_TLS=true

# --- Opcionais: OAuth (descomente e preencha para habilitar) ---
# GitHub
# AUTH_GITHUB_CLIENT_ID=
# AUTH_GITHUB_CLIENT_SECRET=
# GitLab
# AUTH_GITLAB_CLIENT_ID=
# AUTH_GITLAB_CLIENT_SECRET=
# Google
# AUTH_GOOGLE_CLIENT_ID=
# AUTH_GOOGLE_CLIENT_SECRET=